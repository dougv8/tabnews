{
  "name": "tabnews",
  "version": "1.0.0",
  "type": "module",
  "description": "Implementação do https://www.tabnews.com.br para o https://curso.dev",
  "main": "index.js",
  "dependencies": {
    "async-retry": "1.3.3",
    "bcryptjs": "3.0.3",
    "caniuse-lite": "1.0.30001799",
    "client-only": "0.0.1",
    "cookie": "1.1.1",
    "dotenv": "17.4.2",
    "dotenv-expand": "13.0.0",
    "js-tokens": "10.0.0",
    "loose-envify": "1.4.0",
    "nanoid": "5.1.11",
    "next": "16.2.9",
    "next-connect": "1.0.0",
    "node-pg-migrate": "8.0.4",
    "nodemailer": "9.0.1",
    "pg": "8.21.0",
    "picocolors": "1.1.1",
    "postcss": "8.5.15",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "scheduler": "0.27.0",
    "source-map-js": "1.2.1",
    "styled-jsx": "5.1.7",
    "swr": "2.4.1",
    "tslib": "2.8.1",
    "uuid": "14.0.0"
  },
  "scripts": {
    "dev": "npm run services:up && npm run services:wait:database && npm run migrations:up && next dev",
    "test": "npm run services:up && concurrently -n next,jest --hide next -k -s command-jest \"next dev\" \"NODE_OPTIONS=--experimental-vm-modules jest --runInBand --verbose\" ",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll --runInBand --verbose",
    "posttest": "npm run services:stop",
    "services:up": "docker compose -f infra/compose.yaml up -d",
    "services:stop": "docker compose -f infra/compose.yaml stop",
    "services:start": "docker compose -f infra/compose.yaml start",
    "services:down": "docker compose -f infra/compose.yaml down",
    "services:wait:database": "node infra/scripts/wait-for-postgres.js",
    "migrations:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migrations:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "prepare": "husky",
    "commit": "cz"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.5.0",
    "commitizen": "4.3.2",
    "concurrently": "10.0.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.5.0",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.15.2",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "prettier": "3.8.4",
    "set-cookie-parser": "3.1.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "engines": {
    "node": "24"
  }
}
